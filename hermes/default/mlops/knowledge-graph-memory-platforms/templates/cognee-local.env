# Cognee Local Ollama Configuration
# Copy to .env in your project root

# ============================================
# LLM (Chat / Summarization / Extraction)
# ============================================
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:4b
LLM_ENDPOINT=http://localhost:11434/v1
LLM_API_KEY=dummy
LLM_INSTRUCTOR_MODE=json_mode

# Optional: per-stage model overrides
# LLM_EXTRACTION_MODEL=
# LLM_SUMMARIZATION_MODEL=

# ============================================
# EMBEDDINGS (CRITICAL: use /api/embed, NOT /v1/embeddings)
# ============================================
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text:latest
EMBEDDING_ENDPOINT=http://localhost:11434/api/embed
EMBEDDING_DIMENSIONS=768

# ============================================
# DATABASE (defaults: SQLite + Kuzu + LanceDB)
# ============================================
# DB_PROVIDER=sqlite
# VECTOR_DB_PROVIDER=lancedb
# GRAPH_DATABASE_PROVIDER=kuzu

# For Postgres backend (production):
# DB_PROVIDER=postgres
# VECTOR_DB_PROVIDER=pgvector
# GRAPH_DATABASE_PROVIDER=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=cognee
# DB_PASSWORD=cognee
# DB_NAME=cognee_db

# ============================================
# AUTH / MULTI-TENANT
# ============================================
# ENABLE_BACKEND_ACCESS_CONTROL=false
# REQUIRE_AUTHENTICATION=false

# ============================================
# CACHING / PERFORMANCE
# ============================================
# CACHING=true  # Session memory (SQLite cache)
# LLM_RATE_LIMIT_ENABLED=false
# EMBEDDING_RATE_LIMIT_ENABLED=false

# ============================================
# DEVELOPMENT
# ============================================
COGNEE_SKIP_CONNECTION_TEST=true
# LOG_LEVEL=INFO