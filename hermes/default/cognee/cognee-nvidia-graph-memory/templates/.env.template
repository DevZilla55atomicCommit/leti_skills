# Cognee + NVIDIA NIM Graph Memory Configuration
# Copy this to ~/.env and fill in your NVIDIA API key

# Graph Memory (NVIDIA NIM for extraction)
LLM_PROVIDER=custom
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
LLM_ENDPOINT=https://integrate.api.nvidia.com/v1
LLM_API_KEY=nvapi-YOUR_KEY_HERE
LLM_INSTRUCTOR_MODE=

# Local Embeddings (Ollama)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text:latest
EMBEDDING_ENDPOINT=http://localhost:11434/api/embed
EMBEDDING_DIMENSIONS=768

# Skip connection tests (avoids startup delays)
COGNEE_SKIP_CONNECTION_TEST=true

# Optional: OpenAI for extraction fallback (uncomment if needed)
# LLM_EXTRACTION_PROVIDER=openai
# LLM_EXTRACTION_MODEL=gpt-4o-mini
# LLM_EXTRACTION_API_KEY=sk-...